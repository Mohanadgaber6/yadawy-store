# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/yadawy.db

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=8h

# Admin Seed (used only during initial setup)
ADMIN_EMAIL=admin@yadawy.com
ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# Upload
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
UPLOAD_DIR=./uploads
